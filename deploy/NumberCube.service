[Unit]
Description=NumberCube Node.js Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/NumberCube
ExecStart=/usr/bin/node /opt/NumberCube/backend/server.js
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3011
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
